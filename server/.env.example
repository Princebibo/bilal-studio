# ─────────────────────────────────────────────────────────────
#  Copy to `.env` and fill in. NEVER commit the real .env file.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
PORT=3000

# Comma-separated list of origins allowed to call this API.
# Use your real domain(s) in production — do not ship "*".
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Where lead + payment notifications are sent ───────────────
NOTIFY_EMAIL=you@yourdomain.com

# ── Email driver: "smtp" (Nodemailer) or "sendgrid" ───────────
MAIL_DRIVER=smtp

# The From: address. Must be a domain/address you are authorised
# to send as, or your mail will land in spam.
MAIL_FROM_NAME=Bibo Saya Studio
MAIL_FROM_EMAIL=hello@yourdomain.com

# --- if MAIL_DRIVER=smtp ---
# Gmail requires a 16-character App Password (Google Account →
# Security → 2-Step Verification → App passwords). Your normal
# account password will NOT work.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=you@yourdomain.com
SMTP_PASS=your_16_char_app_password

# --- if MAIL_DRIVER=sendgrid ---
SENDGRID_API_KEY=

# ── PayPal ────────────────────────────────────────────────────
# Credentials come from the PayPal Developer Dashboard, from an
# app created under the MERCHANT ACCOUNT THAT SHOULD RECEIVE THE
# MONEY. Funds follow the credentials — see README for why there
# is no "payee email" field to set anywhere in this project.
PAYPAL_ENV=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Created in Dashboard → Webhooks. Required for signature
# verification; without it every webhook is rejected.
PAYPAL_WEBHOOK_ID=

# ── Pricing (server-authoritative, in cents) ──────────────────
# The client never sends a price. It sends a quantity; the server
# derives the amount from these tiers. Do not move this to the
# frontend.
PRICE_TIER_1=4500
PRICE_TIER_2_4=4000
PRICE_TIER_5_9=3500
PRICE_TIER_10_PLUS=3000
MAX_QUANTITY=100
SHIPPING_FLAT_CENTS=0
CURRENCY=USD
