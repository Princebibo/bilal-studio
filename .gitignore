# ── Dependencies ─────────────────────────────────────────────
node_modules/

# ── Secrets ──────────────────────────────────────────────────
# Never commit a real .env. The template (.env.example) is tracked.
.env
.env.*
!.env.example

# ── Local tooling ────────────────────────────────────────────
# .claude/ holds installed third-party skills (several MB) and
# machine-specific permission grants. launch.json is the shared
# dev-server config, so that one is kept.
.claude/*
!.claude/launch.json

# ── Build / logs / OS noise ──────────────────────────────────
dist/
build/
*.log
npm-debug.log*
.DS_Store
Thumbs.db
desktop.ini

# ── Editor ───────────────────────────────────────────────────
.vscode/
.idea/
*.swp

# ── Unrelated projects sharing this parent folder ────────────
# These are separate efforts that happen to live in the same
# directory. They are not part of this site, and some contain their
# own .git — which makes a bare `git add -A` abort outright.
Pet_DNA_Lab_GDD.md
Pet_DNA_Lab_Master_Implementation_Plan.md
garden-assets/
pet-dna-lab/
roblox-7days/
roblox-dont-let-it-in/
roblox-lobby/
